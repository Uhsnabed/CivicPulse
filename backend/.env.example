APP_ENV=development
API_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3000

# Add these in Module 2 after creating a Supabase project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=civic-evidence

# Server-only. Never copy these values to frontend/.env.local.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: change only if your Google AI Studio key exposes a different Flash model.
GEMINI_MODEL=gemini-2.5-flash
